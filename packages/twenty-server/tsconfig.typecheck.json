{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "rootDir": ".",
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "@types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/**/__test__/**",
    "src/**/__tests__/**",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
