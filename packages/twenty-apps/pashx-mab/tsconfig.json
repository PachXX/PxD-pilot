{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
