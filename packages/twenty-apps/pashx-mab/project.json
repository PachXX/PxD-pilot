{
  "name": "pashx-mab",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-apps/pashx-mab/src",
  "projectType": "library",
  "tags": ["scope:pashx", "scope:twenty-app"],
  "implicitDependencies": ["pashx-mab-contract", "twenty-sdk"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["pashx-mab-contract:build", "twenty-sdk:build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    },
    "lint": {},
    "fmt": {
      "options": {
        "files": "src"
      },
      "configurations": {
        "fix": {}
      }
    }
  }
}
