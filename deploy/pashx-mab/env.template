# PashX MAB runtime environment — TEMPLATE ONLY.
#
# This file documents the contract from docs/execution/evidence/CX0-cloud-readiness.md.
# It contains NO values and is never used at runtime.
#
# At runtime the VM startup script builds /run/pashx-mab/app.env on a tmpfs mount by reading
# Secret Manager. Nothing below marked (secret) may ever appear in git, in Terraform state,
# in a plan output, on a command line, or in chat.

# --- Server ------------------------------------------------------------------
NODE_PORT=3000
# Canonical external HTTPS origin. Terraform output `server_url`.
SERVER_URL=

# --- Data --------------------------------------------------------------------
# (secret) Secret Manager: pashx-mab-pg-database-url
# Generated by Terraform from the Cloud SQL private IP and the generated app password.
PG_DATABASE_URL=

# Container-local Redis on the same VM. Not managed Memorystore — see IDR-0001.
REDIS_URL=redis://redis:6379

# --- Migration ownership -----------------------------------------------------
# Server: false / false.  Worker: true / true.  Exactly one migration owner.
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=

# --- Application secrets -----------------------------------------------------
# (secret) Secret Manager: pashx-mab-app-secret
APP_SECRET=
# (secret) Secret Manager: pashx-mab-encryption-key
ENCRYPTION_KEY=
# (secret) Secret Manager: pashx-mab-fallback-encryption-key
FALLBACK_ENCRYPTION_KEY=

# --- Storage (GCS through Twenty's S3 driver) ---------------------------------
STORAGE_TYPE=s3
# Terraform var.region.
STORAGE_S3_REGION=
# Terraform output `documents_bucket`.
STORAGE_S3_NAME=
# GCS XML interoperability endpoint. Frozen by the Gate 0 compatibility suite.
STORAGE_S3_ENDPOINT=https://storage.googleapis.com
# (secret) Secret Manager: pashx-mab-storage-hmac-access-key
STORAGE_S3_ACCESS_KEY_ID=
# (secret) Secret Manager: pashx-mab-storage-hmac-secret
STORAGE_S3_SECRET_ACCESS_KEY=
# HMAC credentials were present from CL0 but this flag was never set, so every
# upload/download silently fell back to server-mediated streaming instead of
# a direct browser<->GCS presigned URL. Closed as part of the Gate 0 storage
# suite follow-up (2026-08-14) — see CL0-provisioning-evidence.md.
STORAGE_S3_PRESIGNED_URL_ENABLED=true

# --- Deployment metadata ------------------------------------------------------
# Digest-pinned image. A tag is rejected by Terraform validation and by the acceptance check.
PASHX_IMAGE=
